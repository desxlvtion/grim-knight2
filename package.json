{
  "name": "grim-knight",
  "version": "0.1.0",
  "description": "Grim Knight — roguelike inventory game",
  "author": "dunice",
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.grimknight.game",
    "productName": "Grim Knight",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "backend/dist/grim-knight-backend.exe",
        "to": "backend/grim-knight-backend.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}